# ══════════════════════════════════════════════════════════════════════════════
# Pro Clean — environment varijable
# Kopiraj ovaj file, preimenuj u .env.local i popuni vrijednosti.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# 1. Idi na https://resend.com → registracija (besplatno, 100 mailova/dan)
# 2. API Keys → Create API Key → kopiraj
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email na koji stižu obavijesti (tvoj poslovni mail)
ADMIN_EMAIL=info@proclean.hr

# "Od" adresa (mora biti domena koja je verificirana u Resendu)
# Za testiranje bez domene koristi: onboarding@resend.dev
FROM_EMAIL=portal@proclean.hr


# ─── SMS (odaberi jednog od dva provajdera) ───────────────────────────────────
# Koji SMS servis koristiti: "twilio" ili "infobip"
SMS_PROVIDER=twilio

# Tvoj mobilni broj (na koji stižu SMS-ovi) — format: +385XXXXXXXXX
ADMIN_PHONE=+385994840416

# ── Opcija 1: Twilio ──────────────────────────────────────────────────────────
# 1. Idi na https://twilio.com → besplatni trial (~$15 kredita, ~300 SMS-ova)
# 2. Console → Account SID + Auth Token
# 3. Phone Numbers → Get a number (HR nije dostupan kao Twilio broj, ali može
#    slati na HR) — uzmi američki broj za slanje
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_PHONE=+14155238886

# ── Opcija 2: Infobip (hrvatska firma!) ───────────────────────────────────────
# 1. Idi na https://www.infobip.com/signup → besplatni trial (100 SMS-ova)
# 2. API Keys → kopiraj API key
# 3. Base URL je prikazan na dashboardu (npr. xxxxx.api.infobip.com)
# Prednost: hrvatska tvrtka, HR brojevi podržani kao pošiljatelj
INFOBIP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INFOBIP_BASE_URL=xxxxx.api.infobip.com
